# /etc/crest-fleet/events.env - settings of crest-events.service (the hourly
# 2-D event tick, scripts/event_tick_daemon.py). events-setup.sh copies this
# once and never overwrites it.
# No secrets here: the token lives only in /etc/crest-fleet/events_hf_token
# (root:root 0600, handed to the service as a systemd credential).
# systemd EnvironmentFile syntax: one KEY=VALUE per line, no spaces in values,
# no inline comments. After editing: sudo systemctl restart crest-events

# ---- code pin: events-setup.sh checks this CREST_AI ref out (a full commit
# SHA for production; a branch is resolved to its SHA at install time and
# never floats afterwards). run-events.sh never fetches.
CREST_AI_REF=main

# ---- mirrored from the HF CREST_runner Space variables (2026-11-05).
# Diff against Settings > Variables of that Space before the cutover: any
# other EVENT_* there (retention, reopen window, ...) belongs here too.
EVENT_QUEUE_MODE=on
EVENT_CPU_FALLBACK_H=inf
EVENT_QUEUE_MAX_AGE_H=720
EVENT_QUEUE_MAX_CELLS=16000000
EVENT_DEM_RES=1
CREST_DEMO_MOCK=0
# provenance + tick status host name (claims and manifests come from the worker)
EVENT_ENGINE_IDENT=js2-events
# PI 2026-11-05: the GPU stays g3.large (ceiling ~37.7M cells): the native
# capacity preflight keeps deferring basins above 35M
EVENT_PREP_MAX_CELLS=35000000
# The HF ZeroGPU worker is paused: a ping cannot wake a paused Space, and the
# VM's crest-worker polls the queue by itself. Empty = no wake pings. List
# the Space URL again (comma-separated) if that worker is ever resumed.
EVENT_WORKER_WAKE_URLS=

# ---- the daemon
# a tick when the gauged nowcast issue advances (at most once per issue),
# and at least this often (minutes from the previous tick's start)
EVENT_TICK_MAX_GAP_MIN=70
EVENT_TICK_POLL_S=60
# SIGTERM during a tick: wait this long for it (from the signal). With the
# final status commit (<= 60 s) and 60 s for the exit it fits the unit's
# TimeoutStopSec=720; a larger value is cut to fit
EVENT_TICK_STOP_GRACE_S=600
# Outer bound on one tick, hours from its start: past it the tick is wedged -
# the daemon logs every thread's stack, publishes "wedged" (bounded) and
# exits 3; systemd restarts it (KillMode=mixed reaps a leftover EF5, the
# saved schedule keeps the issue) and the max gap ticks again at once.
# Legitimate ticks take minutes to ~2 h (EF5 runs of minutes each); the
# Spaces' /api/health reports wedged from 4 h (HEALTH_WEDGE_MAX_H). 0 = none
EVENT_TICK_MAX_BUSY_H=8
# EF5's own run-time cap (hf_data/runner.py; 10 h on the Spaces), set so it
# is the binding one: a runaway EF5 run (warm-up or main) is killed at 3 h,
# the tick records it and goes on with its other events - one event's two
# runs at the cap (6 h) stay inside the 8-h bound above, which is left for
# what no inner watchdog sees (a hung read, a kill that did not take). EF5
# silent for 45 min (CREST_STALL_TIMEOUT_S) is killed long before either
CREST_RUN_TIMEOUT_S=10800
# events/tick_status.json while a tick runs (commits; 256/h per account)
EVENT_TICK_STATUS_BEAT_MIN=15
# no tick while the HF runner Space still runs its own (its /api/runner_status)
EVENT_TICK_GUARD_URL=https://vincewin-crest-runner.hf.space
# CONUS state mosaic index (vincewin/CREST_fleet mosaic/index.json, rebuilt
# at most daily from the tick): 1 needs repo.write on CREST_fleet in the
# token; 0 skips it (then nothing refreshes it after the cutover - see README)
CREST_MOSAIC_REFRESH=1

# ---- data on the attached volume (crest-events owns these; 0750)
CREST_CACHE_DIR=/media/volume/crest-data/events/cache
HF_HOME=/media/volume/crest-data/events/hub
TMPDIR=/media/volume/crest-data/events/tmp
EVENT_DEM_CACHE=/media/volume/crest-data/events/dem_cache
EVENT_TICK_STATE_DIR=/media/volume/crest-data/events/state
# run-events.sh warns (never refuses) below this
EVENTS_MIN_FREE_GB=20

GDAL_HTTP_MAX_RETRY=5
GDAL_HTTP_RETRY_DELAY=2
# /vsicurl reads (terrain, parameter, snow and flow-accumulation COG
# windows) must not block forever - GDAL has no timeout by default, and a
# hung read hangs the tick: per HTTP request at most 30 s to connect and
# 600 s in all, and a transfer slower than 1 KB/s for 60 s is aborted. The
# readers retry; the parameter clips then fall back to a whole-file
# download (huggingface_hub, bounded by its own timeouts)
GDAL_HTTP_CONNECTTIMEOUT=30
GDAL_HTTP_TIMEOUT=600
GDAL_HTTP_LOW_SPEED_TIME=60
GDAL_HTTP_LOW_SPEED_LIMIT=1024
HF_HUB_DISABLE_TELEMETRY=1
