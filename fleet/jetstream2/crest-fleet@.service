# crest-fleet@K.service - fleet shard K of FLEET_N on a Jetstream2 host, for
# the size class FLEET_SIZE (big: basins >= 5,000 km2; the HF runners take
# the small ones - README "Who runs what"). The 2-D GPU worker
# (crest-worker.service) has priority: all shards share crest-fleet.slice
# (one memory ceiling, low CPU/IO weight), run niced, and are the first OOM
# victims.
[Unit]
Description=CREST gauged fleet shard %i (fleet/fleet_run.py -> vincewin/CREST_fleet)
Documentation=https://github.com/mchen15ouedu/CREST_AI/blob/main/fleet/jetstream2/README.md
Wants=network-online.target
After=network-online.target crest-worker.service
RequiresMountsFor=/media/volume/crest-data
AssertFileNotEmpty=/etc/crest-fleet/hf_token
StartLimitIntervalSec=0

[Service]
Type=simple
User=crest-fleet
Group=crest-fleet
EnvironmentFile=/etc/crest-fleet/fleet.env
Environment=PYTHONUNBUFFERED=1
Environment=FLEET_HOME=/opt/crest-fleet
# EF5 (fork) is built with OpenMP and would start one thread per vCPU
# in every worker process; fleet.env may override
Environment=OMP_NUM_THREADS=2
LoadCredential=hf_token:/etc/crest-fleet/hf_token
UnsetEnvironment=HF_TOKEN HUGGING_FACE_HUB_TOKEN
WorkingDirectory=/opt/crest-fleet/src
ExecStart=/opt/crest-fleet/bin/run-fleet.sh %i
# a finished pass (or a refused start) retries after 30 min, like the Spaces
Restart=always
RestartSec=1800
KillMode=control-group
TimeoutStopSec=60
SyslogIdentifier=crest-fleet-%i
Slice=crest-fleet.slice
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
OOMScoreAdjust=500
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
