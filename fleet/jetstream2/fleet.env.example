# /etc/crest-fleet/fleet.env - settings for every crest-fleet@K shard.
# No secrets here: the token lives only in /etc/crest-fleet/hf_token
# (root:root 0600, handed to the service as a systemd credential).
# systemd EnvironmentFile syntax: one KEY=VALUE per line, no spaces in values
# (FLEET_GAUGES takes a comma list without spaces, or a file path).
# After editing: sudo systemctl restart 'crest-fleet@*'

# size class: this host runs the basins >= FLEET_BIG_KM2; the HF runners take
# the smaller ones (README "Who runs what")
FLEET_SIZE=big
FLEET_BIG_KM2=5000
# split of the big class between this host's crest-fleet@K units: K of FLEET_N
FLEET_N=1
# parallel outlets per shard (each EF5 runs OMP_NUM_THREADS=2, a few GB RAM)
FLEET_WORKERS=4
FLEET_GAUGES=all
FLEET_START=2021-07-01
FLEET_END=2026-06-30

# persistent cache on the data volume: month tars stay cached (the HF runners
# re-download them for every gauge); per-gauge clip stores are dropped after
# each upload (fleet_run.py FLEET_PRUNE_FORCING)
FLEET_PRUNE_FORCING=1
CREST_CACHE_DIR=/media/volume/crest-data/fleet/cache
HF_HOME=/media/volume/crest-data/fleet/hub
TMPDIR=/media/volume/crest-data/fleet/tmp
# housekeeping (hourly): finished EF5 run workdirs, crash-leftover clip stores
FLEET_WORKDIR_TTL_H=24
FLEET_STORE_TTL_D=7

# disk guard (shared with the 2-D worker): a shard refuses to start below
# MIN free or above MAX_INODE_PCT; below STOP the housekeeper drops hub blobs
# unread for HUB_KEEP_DAYS, then restarts running shards (they wait for space)
FLEET_MIN_FREE_GB=60
FLEET_STOP_FREE_GB=30
FLEET_MAX_INODE_PCT=85
FLEET_HUB_KEEP_DAYS=7

CREST_DEMO_MOCK=0
GDAL_HTTP_MAX_RETRY=5
GDAL_HTTP_RETRY_DELAY=2
HF_HUB_DISABLE_TELEMETRY=1
